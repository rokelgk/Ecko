{
  "manifestVersion": 5,
  "id": "com.ecko.tone",
  "name": "Ecko Tone",
  "version": "0.4.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "tonePanel",
      "label": {
        "default": "Ecko Tone"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "maximumSize": {
        "width": 600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 620
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
